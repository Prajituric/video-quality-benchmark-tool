{
  "description": "Template for adding other services. Upload sources/<id>.mp4 to each service with its own tooling, fill in the URL templates, then copy the provider entries into your config.",
  "vmaf_model": "hd",
  "bitrates_kbps": [1000, 2500, 4500, 6000],
  "sources": [
    {"id": "crowd_run", "url": "https://media.xiph.org/video/derf/y4m/crowd_run_1080p50.y4m", "frames": 250}
  ],
  "providers": {
    "service_with_bitrate_param": {
      "type": "url_template",
      "url_template": "https://media.example.com/{source_id}.mp4?bitrate={kbps}k",
      "source_id_map": {"crowd_run": "REPLACE_WITH_SERVICE_ASSET_ID"}
    },
    "service_with_fixed_ladder": {
      "type": "url_template",
      "url_template": "https://stream.example.com/{source_id}/{kbps}.mp4",
      "bitrate_ladder": [800, 2000, 4000, 6000],
      "headers_env": {"Authorization": "EXAMPLE_SERVICE_TOKEN"}
    }
  }
}
